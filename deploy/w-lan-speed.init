#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local LISTEN_ADDRESS="127.0.0.1:8899" PEER_URL=""
    [ ! -r /etc/w-lan-speed.conf ] || . /etc/w-lan-speed.conf
    [ ! -x /usr/libexec/w-lan-speed-offload ] || /usr/libexec/w-lan-speed-offload
    procd_open_instance
    procd_set_param command /usr/libexec/w-lan-speed --listen "$LISTEN_ADDRESS"
    [ -z "$PEER_URL" ] || procd_append_param command --peer-url "$PEER_URL"
    procd_set_param user nobody
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    [ ! -x /usr/libexec/w-lan-speed-offload ] || /usr/libexec/w-lan-speed-offload
}

stop_service() {
    nft destroy table inet w_lan_speed
}

service_triggers() {
    procd_add_reload_trigger firewall network
    procd_add_raw_trigger "interface.*" 1000 /etc/init.d/w-lan-speed reload
}
